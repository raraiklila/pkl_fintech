-- 1. Create Gold Price Table
CREATE TABLE IF NOT EXISTS gold_price (
    id SERIAL PRIMARY KEY,
    price NUMERIC NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Seed Default Gold Price (Rp 1.100.000 / gram) if not exists
INSERT INTO gold_price (id, price)
VALUES (1, 1100000)
ON CONFLICT (id) DO NOTHING;


-- 2. Stored Function: Setup Installment Transaction
CREATE OR REPLACE FUNCTION create_installment_tx(
    p_merchant_id INT,
    p_target_weight NUMERIC,
    p_total_installment_amount NUMERIC,
    p_split_percentage INT
) RETURNS JSON AS $$
DECLARE
    v_new_inst RECORD;
BEGIN
    -- Validate input splits
    IF p_target_weight <= 0 OR p_total_installment_amount <= 0 OR p_split_percentage <= 0 THEN
        RAISE EXCEPTION 'Input cicilan tidak valid';
    END IF;

    -- Validate Merchant Exist
    IF NOT EXISTS (
        SELECT 1 FROM merchant WHERE id = p_merchant_id
    ) THEN
        RAISE EXCEPTION 'Merchant tidak ditemukan';
    END IF;

    -- 1. Deactivate existing active installments
    UPDATE installment
    SET is_active = false
    WHERE merchant_id = p_merchant_id;

    -- 2. Insert new active installment
    INSERT INTO installment (
        merchant_id, target_weight, total_installment_amount, split_percentage, accumulated_amount, accumulated_gold_weight, is_active
    ) VALUES (
        p_merchant_id, p_target_weight, p_total_installment_amount, p_split_percentage, 0.0, 0.0, true
    ) RETURNING * INTO v_new_inst;

    RETURN row_to_json(v_new_inst);
END;
$$ LANGUAGE plpgsql;


-- 3. Stored Function: Cash Withdrawal Transaction (Tarik Saldo)
CREATE OR REPLACE FUNCTION withdraw_balance_tx(
    p_merchant_id INT,
    p_amount NUMERIC
) RETURNS JSON AS $$
DECLARE
    v_balance RECORD;
    v_transaction_id TEXT;
    v_new_tx RECORD;
BEGIN
    -- Validate amount
    IF p_amount <= 0 THEN
        RAISE EXCEPTION 'Nominal penarikan harus lebih besar dari nol';
    END IF;

    -- Lock balance record to prevent race conditions
    SELECT * INTO v_balance FROM balance WHERE merchant_id = p_merchant_id FOR UPDATE;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Saldo merchant tidak ditemukan';
    END IF;

    IF v_balance.main_balance < p_amount THEN
        RAISE EXCEPTION 'Saldo tidak mencukupi';
    END IF;

    -- Update balance
    UPDATE balance
    SET main_balance = main_balance - p_amount
    WHERE merchant_id = p_merchant_id;

    -- Generate transaction ID (TD prefix, QG suffix)
    v_transaction_id := 'TD' || to_char(CURRENT_TIMESTAMP, 'YY') || lpad((random() * 900000 + 100000)::INT::TEXT, 6, '0') || 'QG';

    -- Insert Transaction
    INSERT INTO transaksi (
        id, merchant_id, type, title, total_amount, main_amount, gold_amount, gold_weight_added, mdr_fee
    ) VALUES (
        v_transaction_id, p_merchant_id, 'WITHDRAW', 'Tarik Saldo Rekening',
        -p_amount, -p_amount, 0.0, 0.0, 0.0
    ) RETURNING * INTO v_new_tx;

    RETURN row_to_json(v_new_tx);
END;
$$ LANGUAGE plpgsql;


-- 4. Stored Function: Buy Gold Transaction (Beli Emas)
CREATE OR REPLACE FUNCTION buy_gold_tx(
    p_merchant_id INT,
    p_amount NUMERIC
) RETURNS JSON AS $$
DECLARE
    v_balance RECORD;
    v_installment RECORD;
    v_new_accumulated_amount NUMERIC;
    v_new_accumulated_weight NUMERIC;
    v_is_completed BOOLEAN := false;
    v_transaction_id TEXT;
    v_new_tx RECORD;
    v_additional_gold_balance_reward NUMERIC := 0;
    v_gold_price NUMERIC;
    v_gold_weight_added NUMERIC;
BEGIN
    -- Validate inputs
    IF p_amount <= 0 THEN
        RAISE EXCEPTION 'Nominal pembelian emas harus lebih besar dari nol';
    END IF;

    -- Fetch current Gold Price from the database
    SELECT price INTO v_gold_price FROM gold_price ORDER BY updated_at DESC LIMIT 1;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Harga emas tidak tersedia'; 
    END IF;
    
    v_gold_weight_added := p_amount / v_gold_price;

    -- Lock balance record to prevent race conditions
    SELECT * INTO v_balance FROM balance WHERE merchant_id = p_merchant_id FOR UPDATE;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Saldo merchant tidak ditemukan';
    END IF;

    IF v_balance.main_balance < p_amount THEN
        RAISE EXCEPTION 'Saldo tidak mencukupi';
    END IF;

    -- Fetch and Lock Active Installment (if any)
    SELECT * INTO v_installment FROM installment 
    WHERE merchant_id = p_merchant_id AND is_active = true FOR UPDATE;

    IF NOT FOUND THEN
        -- No active installment
    ELSE
        v_new_accumulated_amount := v_installment.accumulated_amount + p_amount;
        v_new_accumulated_weight := v_installment.accumulated_gold_weight + v_gold_weight_added;
        v_is_completed := v_new_accumulated_amount >= v_installment.total_installment_amount;

        UPDATE installment
        SET accumulated_amount = v_new_accumulated_amount,
            accumulated_gold_weight = v_new_accumulated_weight,
            is_active = NOT v_is_completed
        WHERE id = v_installment.id;

        IF v_is_completed THEN
            v_additional_gold_balance_reward := v_installment.target_weight;
        END IF;
    END IF;

    -- Update balances (deduct money, add gold)
    UPDATE balance
    SET main_balance = main_balance - p_amount,
        gold_balance = gold_balance + v_gold_weight_added + v_additional_gold_balance_reward
    WHERE merchant_id = p_merchant_id;

    -- Generate transaction ID (BE prefix, QG suffix)
    v_transaction_id := 'BE' || to_char(CURRENT_TIMESTAMP, 'YY') || lpad((random() * 900000 + 100000)::INT::TEXT, 6, '0') || 'QG';

    -- Insert Transaction
    INSERT INTO transaksi (
        id, merchant_id, type, title, total_amount, main_amount, gold_amount, gold_weight_added, mdr_fee
    ) VALUES (
        v_transaction_id, p_merchant_id, 'GOLD_BUY', 'Beli Emas Digital',
        -p_amount, -p_amount, p_amount, v_gold_weight_added, 0.0
    ) RETURNING * INTO v_new_tx;

    RETURN row_to_json(v_new_tx);
END;
$$ LANGUAGE plpgsql;


-- 5. Stored Function: Sell Gold Transaction (Jual Emas)
CREATE OR REPLACE FUNCTION sell_gold_tx(
    p_merchant_id INT,
    p_gold_weight NUMERIC
) RETURNS JSON AS $$
DECLARE
    v_balance RECORD;
    v_transaction_id TEXT;
    v_new_tx RECORD;
BEGIN
    -- Validate inputs
    IF p_amount <= 0 OR p_gold_weight <= 0 THEN
        RAISE EXCEPTION 'Nominal penjualan dan berat emas harus lebih besar dari nol';
    END IF;

    -- Lock balance record to prevent race conditions
    SELECT * INTO v_balance FROM balance WHERE merchant_id = p_merchant_id FOR UPDATE;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Saldo merchant tidak ditemukan';
    END IF;

    IF v_balance.gold_balance < p_gold_weight THEN
        RAISE EXCEPTION 'Saldo emas tidak mencukupi';
    END IF;

    -- Update balances (add money, deduct gold)
    UPDATE balance
    SET main_balance = main_balance + p_amount,
        gold_balance = gold_balance - p_gold_weight
    WHERE merchant_id = p_merchant_id;

    -- Generate transaction ID (JE prefix, QG suffix)
    v_transaction_id := 'JE' || to_char(CURRENT_TIMESTAMP, 'YY') || lpad((random() * 900000 + 100000)::INT::TEXT, 6, '0') || 'QG';

    -- Insert Transaction
    INSERT INTO transaksi (
        id, merchant_id, type, title, total_amount, main_amount, gold_amount, gold_weight_added, mdr_fee
    ) VALUES (
        v_transaction_id, p_merchant_id, 'GOLD_SELL', 'Jual Emas Digital',
        p_amount, p_amount, -p_amount, -p_gold_weight, 0.0
    ) RETURNING * INTO v_new_tx;

    RETURN row_to_json(v_new_tx);
END;
$$ LANGUAGE plpgsql;


-- 6. Stored Function: QRIS Simulation Transaction (Autosplit & MDR)
CREATE OR REPLACE FUNCTION simulate_qris_payment_tx(
    p_merchant_id INT,
    p_amount NUMERIC,
    p_mdr_umi_rate NUMERIC,
    p_mdr_non_umi_rate NUMERIC,
    p_mdr_limit NUMERIC
) RETURNS JSON AS $$
DECLARE
    v_merchant RECORD;
    v_installment RECORD;
    v_balance RECORD;
    v_mdr_rate NUMERIC;
    v_mdr_fee NUMERIC;
    v_net_amount NUMERIC;
    v_gold_cut NUMERIC := 0;
    v_balance_cut NUMERIC;
    v_gold_weight_added NUMERIC := 0;
    v_new_accumulated_amount NUMERIC;
    v_new_accumulated_weight NUMERIC;
    v_is_completed BOOLEAN := false;
    v_transaction_id TEXT;
    v_new_tx RECORD;
    v_additional_gold_balance_reward NUMERIC := 0;
    v_gold_price NUMERIC;
BEGIN
    -- Validate amount
    IF p_amount <= 0 THEN
        RAISE EXCEPTION 'Nominal pembayaran QRIS harus lebih besar dari nol';
    END IF;

    -- Fetch current Gold Price from the database
    SELECT price INTO v_gold_price FROM gold_price ORDER BY updated_at DESC LIMIT 1;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Harga emas tidak tersedia'; 
    END IF;

    -- 1. Lock Merchant Details to prevent race conditions on write
    SELECT * INTO v_merchant FROM merchant WHERE id = p_merchant_id FOR UPDATE;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Merchant tidak ditemukan';
    END IF;

    -- 2. Lock Active Installment
    SELECT * INTO v_installment FROM installment 
    WHERE merchant_id = p_merchant_id AND is_active = true FOR UPDATE;

    -- 3. Calculate MDR Fee
    IF v_merchant.is_umi THEN
        IF p_amount <= p_mdr_limit THEN
            v_mdr_rate := 0.0;
        ELSE
            v_mdr_rate := p_mdr_umi_rate;
        END IF;
    ELSE
        v_mdr_rate := p_mdr_non_umi_rate;
    END IF;
    
    v_mdr_fee := p_amount * v_mdr_rate;
    v_net_amount := p_amount - v_mdr_fee;
    v_balance_cut := v_net_amount;

    -- 4. If there is an active installment, perform Autosplit calculations
    IF NOT FOUND THEN
        -- No active installment
    ELSE
        v_gold_cut := v_net_amount * (v_installment.split_percentage / 100.0);
        v_balance_cut := v_net_amount - v_gold_cut;
        v_gold_weight_added := v_gold_cut / v_gold_price;

        v_new_accumulated_amount := v_installment.accumulated_amount + v_gold_cut;
        v_new_accumulated_weight := v_installment.accumulated_gold_weight + v_gold_weight_added;
        v_is_completed := v_new_accumulated_amount >= v_installment.total_installment_amount;

        UPDATE installment
        SET accumulated_amount = v_new_accumulated_amount,
            accumulated_gold_weight = v_new_accumulated_weight,
            is_active = NOT v_is_completed
        WHERE id = v_installment.id;

        IF v_is_completed THEN
            v_additional_gold_balance_reward := v_installment.target_weight;
        END IF;
    END IF;

    -- 5. Lock and Update Balance
    SELECT * INTO v_balance FROM balance WHERE merchant_id = p_merchant_id FOR UPDATE;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Saldo merchant tidak ditemukan';
    END IF;

    UPDATE balance
    SET main_balance = main_balance + v_balance_cut,
        gold_balance = gold_balance + v_gold_weight_added + v_additional_gold_balance_reward
    WHERE merchant_id = p_merchant_id;

    -- 6. Insert Transaction (QS prefix, QG suffix)
    v_transaction_id := 'QS' || to_char(CURRENT_TIMESTAMP, 'YY') || lpad((random() * 900000 + 100000)::INT::TEXT, 6, '0') || 'QG';
    
    INSERT INTO transaksi (
        id, merchant_id, type, title, total_amount, main_amount, gold_amount, gold_weight_added, mdr_fee
    ) VALUES (
        v_transaction_id, p_merchant_id, 'QRIS_IN', 'Pembayaran QRIS - ' || v_merchant.shop_name,
        p_amount, v_balance_cut, v_gold_cut, v_gold_weight_added, v_mdr_fee
    ) RETURNING * INTO v_new_tx;

    RETURN row_to_json(v_new_tx);
END;
$$ LANGUAGE plpgsql;
